	function Ajax()
	{
		try {
			request = new XMLHttpRequest();
		} catch (trymicrosoft) {
			try {
				request = new ActiveXObject("Msxml2.XMLHTTP");
			} catch (othermicrosoft) {
				try {
					request = new ActiveXObject("Microsoft.XMLHTTP");
				} catch (failed) {
					request = false;
				}
			}
		}
		return request;
	}

	function getStatus() 
	{
		request = Ajax();
		if (!request)
			alert("Error initializing XMLHttpRequest!");
			fecha = new Date()
			tiempo = fecha.getTime()
			request.open("POST", "status?tiempo="+tiempo, true);
			request.onreadystatechange = updateStatus(request);
			request.send(null);
	}

	function updateStatus(request) 
	{
		if (request.readyState == 4)
        if (request.status == 200) {
			resultado = request.responseText;
            document.getElementById("status").innerHTML = resultado;
			if (resultado=="busy") {
				$.mobile.changePage("#incall");
            }
            if (resultado=="idle") {
                if ($('.ui-page-active').attr('id')=="incall") {
					$.mobile.changePage("#home");
                }
            }
        }
	}
	
